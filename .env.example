# Public project URL and publishable (or legacy anon) key only. Never a service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Use /dog-walking-website/ for GitHub project Pages; / for a custom domain.
VITE_BASE_PATH=/

# Public Cloudflare Turnstile site key (the secret belongs only in Edge Function secrets).
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
